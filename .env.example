# ==============================================================================
# CONFIGURAÇÕES DE DEPLOY INSTITUCIONAL — LAPS (UFPA)
# ==============================================================================
# Copie este arquivo para .env e preencha as credenciais:
#   cp .env.example .env
#
# NUNCA comite o arquivo .env no Git! Ele está protegido pelo .gitignore.
# ==============================================================================

# Credenciais de FTP/TLS fornecidas pelo CTIC/UFPA para o servidor laps.ufpa.br
FTP_HOST=laps.ufpa.br
FTP_PORT=21
FTP_SSL=true
FTP_USER=laps
FTP_PASS=sua_senha_ftp_institucional
FTP_DIR=/

# Configuração da VPN institucional UFPA (Fortinet IPsec ou OpenVPN)
VPN_GATEWAY=vpn.dmz.ufpa.br
VPN_USER=seu_usuario_institucional_sagitta
VPN_PASS=sua_senha_institucional
VPN_PSK=seu_psk_institucional
